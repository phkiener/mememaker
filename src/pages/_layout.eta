<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= it.title %></title>

        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <base href="<%= it.base %>"/>

        <link rel="stylesheet" href="app.css" />
        <link rel="preload" as="json" href="assets/data.json" />
    </head>

    <body>
        <header>
            <h1><%= it.title %></h1>
        </header>

        <main>
            <%~ it.body %>
        </main>

        <footer>

        </footer>

        <script src="app.js" type="module"></script>
    </body>
</html>
