<!DOCTYPE html>
<html lang="en" class="light-dark">
    <head>
        <title><%= it.title %></title>

        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <base href="<%= it.base %>"/>

        <link rel="stylesheet" href="root.css" />
        <link rel="preload" as="json" href="assets/data.json" />
    </head>

    <body class="full-screen flex as-column align-stretch bg-surface fg-primary">
        <header class="pi-6 pb-5 keep-size">
            <h1 class="text-title fg-accent text-no-select"><%= it.title %></h1>
        </header>

        <main class="flex as-column align-stretch gap-4 pi-9 pb-6 text-regular">
            <%~ it.body %>
        </main>

        <script src="app.js" type="module"></script>
    </body>
</html>
