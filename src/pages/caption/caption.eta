<% layout("../_layout", { title: "Mememaker" }) %>

<h2>#</h2>
<section id="caption-container">
    <section class="image">
        <img src="" alt="" />
        <svg>
            <style>
                text {
                    font-family: Impact, sans-serif;
                    text-transform: uppercase;

                    fill: white;
                    stroke: black;
                    stroke-width: 2px;

                    font-size: 36px;

                    user-select: none;
                }

                svg:hover text {
                    outline: 2px dashed black;
                    outline-offset: 1px;

                    cursor: move;
                }
            </style>
        </svg>
    </section>
    <section>
        <div class="captions"></div>
        <div>
            <button type="button" command="show-modal" commandfor="export-dialog">Export</button>
        </div>
    </section>
</section>


<dialog id="export-dialog">
    <canvas></canvas>
    <div>
        <button type="button" command="close" commandfor="export-dialog">Close</button>
    </div>
</dialog>
