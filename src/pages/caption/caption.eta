<% layout("../_layout", { title: "Mememaker" }) %>

<div class="bg-secondary fg-primary round-lg pi-5 pb-4 keep-size flex as-column gap-1">
    <a class="fg-accent hover-opacity-8" href="">Back to templates</a>
    <h2 class="text-heading" id="template-name"></h2>
</div>

<article id="caption-container" class="bg-secondary fg-primary round-lg pi-5 pb-4 flex as-row gap-2">
    <section class="w-fit stack">
        <img src="" alt="" class="contain source" />
        <svg>
            <style>
                text {
                    font-family: Impact, sans-serif;
                    text-transform: uppercase;

                    fill: white;
                    stroke: black;
                    stroke-width: 2px;

                    font-size: 36px;

                    user-select: none;
                }

                svg:hover text {
                    outline: 2px dashed black;
                    outline-offset: 1px;

                    cursor: move;
                }
            </style>
        </svg>
    </section>
    <section class="flex as-column gap-4 align-stretch">
        <div class="flex as-column gap-2 align-stretch no-grow" id="captions"></div>
        <div class="flex as-row gap-2 align-start">
            <button class="text-label-upper bg-accent fg-surface round-md pi-3 pb-2 keep-size hover-opacity-8" type="button" command="show-modal" commandfor="export-dialog">Export</button>
        </div>
    </section>
</article>

<dialog class="mb-auto mi-auto bg-primary fg-primary round-lg flex as-column gap-4 align-center" id="export-dialog">
    <span class="text-regular keep-size">The image has been copied to your clipboard.</span>
    <canvas></canvas>
    <button class="text-label-upper bg-tertiary fg-surface round-md pi-3 pb-2 keep-size hover-opacity-8" type="button" command="close" commandfor="export-dialog">Close</button>
</dialog>
